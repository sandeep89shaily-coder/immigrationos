# DEVELOPMENT ONLY: Docker Compose provides its own settings
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://immigrationos_app:dev_only_app@localhost:5432/immigrationos_dev
AUTH_ISSUER=http://localhost:8080/realms/immigrationos-dev
AUTH_AUDIENCE=immigrationos-api
AUTH_JWKS_URL=http://localhost:8080/realms/immigrationos-dev/protocol/openid-connect/certs
CORS_ORIGINS=http://localhost:3000

# Development-only document handling, disabled by default.
# To enable outside Docker, generate a fresh key using Python:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UPLOADS_ENABLED=false
DOCUMENT_STORAGE_ROOT=./local_dev_documents
DOCUMENT_ENCRYPTION_KEY=

# For fictional documents ONLY. Requires explicit opt-in and API contract review.
EXPERIMENTAL_AI_ENABLED=false
AI_MODEL=
AI_API_KEY=
